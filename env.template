# Database Configuration
DATABASE_URL=postgres://admin:rpgpassword@db:5432/aether_rpg

# JWT Secret (changez cette valeur en production!)
JWT_SECRET=secret_key_super_secure

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Cloudflare R2 Configuration
# Pour obtenir ces valeurs, suivez le guide dans R2_SETUP.md
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your_bucket_name

# Optionnel : URL publique personnalisée si vous avez configuré un domaine personnalisé pour R2
# R2_PUBLIC_URL=https://your-custom-domain.com

# Development
CHOKIDAR_USEPOLLING=true

